@page
@model CustomAlertManager.Web.Pages.Admin.Sources.IndexModel
@{
    ViewData["Title"] = "News sources";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">News sources</h1>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addSourceModal">Add new source</button>
</div>
<p class="text-muted">Feeds that subscriptions can use. Deactivated sources are skipped by the schedule and cannot be chosen.</p>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Feed address</th>
                <th>Subscriptions</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="5" class="text-muted">No sources yet.</td></tr>
            }
            @foreach (var source in Model.Rows)
            {
                <tr>
                    <td>@source.Name</td>
                    <td class="text-break">@source.Url</td>
                    <td>@source.SubscriptionCount</td>
                    <td>
                        @if (source.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Deactivated</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-page="Edit" asp-route-id="@source.Id">Edit</a>
                        <form method="post" class="d-inline" asp-page-handler="Toggle" asp-route-id="@source.Id">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@(source.IsActive ? "Deactivate" : "Activate")</button>
                        </form>
                        <form method="post" class="d-inline" asp-page-handler="Delete" asp-route-id="@source.Id"
                              onsubmit="return confirm('Delete this source? Sources used by subscriptions are deactivated instead.');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="addSourceModal" tabindex="-1" aria-labelledby="addSourceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Add" class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="addSourceModalLabel">Add new source</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (!ViewContext.ModelState.IsValid) { <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div> }
                <div class="mb-3">
                    <label asp-for="Input.Name" class="form-label"></label>
                    <input asp-for="Input.Name" class="form-control" />
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Url" class="form-label">Feed address (RSS or Atom)</label>
                    <input asp-for="Input.Url" class="form-control" placeholder="https://example.com/rss.xml" />
                    <span asp-validation-for="Input.Url" class="text-danger"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Add source</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @if (Model.ShowAddModal)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                new bootstrap.Modal(document.getElementById("addSourceModal")).show();
            });
        </script>
    }
}
