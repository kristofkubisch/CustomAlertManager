@if (User.Identity?.IsAuthenticated == true)
{
    <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/">
        <button type="submit" class="btn btn-outline-secondary btn-sm">Log out @User.Identity.Name</button>
    </form>
}
else
{
    <a class="btn btn-outline-primary btn-sm me-2" asp-area="Identity" asp-page="/Account/Login">Log in</a>
    <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Register">Sign up</a>
}
